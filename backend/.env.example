# Dirección local segura por defecto. Configure 0.0.0.0 solo cuando el entorno lo requiera.
HOST=127.0.0.1
PORT=3000

# Orígenes HTTP/HTTPS separados por comas autorizados para CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Endpoint OAuth2 de Conecta para obtener el token (https:// obligatorio).
CONECTA_TOKEN_URL=https://api-conecta.example.com/oauth2/token
# Endpoint GraphQL de Conecta DataOps para la consulta de cliente (https:// obligatorio).
CONECTA_GRAPHQL_URL=https://api-conecta.example.com/dataops/graphql/cliente
# Credenciales de cliente OAuth2. Reemplace con valores reales gestionados por Secret Manager (nunca versione secretos reales).
CONECTA_CLIENT_ID=your-client-id-here
CONECTA_CLIENT_SECRET=your-client-secret-here
# Scope OAuth2. Valor por defecto de la aplicación: SrcServerCognitoConecta/ConectaApiScope.
CONECTA_SCOPE=SrcServerCognitoConecta/ConectaApiScope
# Clave de usuario requerida en el encabezado x-user-key de las llamadas GraphQL (no es credencial real, reemplace).
CONECTA_X_USER_KEY=your-x-user-key-here
# Timeout (ms) de la solicitud de token. Valor por defecto: 5000.
CONECTA_TOKEN_TIMEOUT_MS=5000
# Timeout (ms) de la solicitud GraphQL. Valor por defecto: 15000.
CONECTA_GRAPHQL_TIMEOUT_MS=15000
