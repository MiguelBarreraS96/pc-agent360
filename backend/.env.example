# Valores no secretos para el despliegue inicial en Cloud Run.
NODE_ENV=production
HOST=0.0.0.0
GOOGLE_CLOUD_PROJECT=sb-dominique-ai
FIRESTORE_DATABASE_ID=pc-agent-360

# Cloud Run inyecta PORT=8080 automáticamente. No defina PORT aquí ni en el Dockerfile.
# CORS_ALLOWED_ORIGINS se mantiene intencionalmente sin configurar hasta conocer
# el dominio HTTPS exacto del frontend. Nunca use un comodín para CORS.
