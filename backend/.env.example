# Referencia sin secretos. El servicio no carga automáticamente archivos .env.
# En producción, inyecte valores mediante variables protegidas de Cloud Run.
NODE_ENV=development
HOST=127.0.0.1

# Firebase Admin y Firestore usan Application Default Credentials de Cloud Run. Nunca configure una clave JSON.
# FIREBASE_PROJECT_ID es opcional cuando ADC ya resuelve el proyecto (GOOGLE_CLOUD_PROJECT sirve como respaldo).
FIREBASE_PROJECT_ID=example-firebase-project

# Firestore: identificador de la base de datos con nombre de este proyecto. "(default)" si no se usa una con nombre.
FIRESTORE_DATABASE_ID=(default)

# Seguridad de navegador. En producción: solo orígenes HTTPS, DATABASE_SSL=true y SameSite=none.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4200
SESSION_COOKIE_NAME=agent360_session
SESSION_COOKIE_SAME_SITE=lax
SESSION_INACTIVITY_TIMEOUT_SECONDS=900

# Solo el job controlado de migración consume este correo a través de app.bootstrap_admin_email.
# Reemplace este ejemplo por el administrador inicial autorizado fuera del repositorio.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Vertex AI Search (Discovery Engine) y Cloud Storage: base de conocimiento RAG por producto.
# FIREBASE_PROJECT_ID (arriba) también se usa como proyecto de Discovery Engine y Cloud Storage.
# RAG_BUCKET_NAME es obligatorio (sin valor por defecto). Si el bucket no existe, el backend lo crea
# automáticamente en RAG_BUCKET_LOCATION la primera vez que arranca.
RAG_BUCKET_NAME=example-agent360-rag-bucket
RAG_BUCKET_LOCATION=US
DISCOVERY_ENGINE_LOCATION=us

# Gemini (Vertex AI) para el chat del agente: usa Application Default Credentials, nunca una API key.
# FIREBASE_PROJECT_ID (arriba) también se usa como proyecto de Gemini. A diferencia de Discovery
# Engine, generateContent es regional: GEMINI_LOCATION no admite "global".
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_LOCATION=us-central1

# Cloud Run inyecta PORT=8080 automáticamente. No defina PORT aquí ni en el Dockerfile.
