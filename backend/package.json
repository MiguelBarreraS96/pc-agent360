{
  "name": "pc-agent360-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API de autenticación Firebase, sesiones y control de acceso para pc-agent360.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "deploy": "node scripts/deploy.mjs",
    "seed": "node --env-file=.env scripts/seed-firestore.mjs"
  },
  "dependencies": {
    "@google-cloud/discoveryengine": "3.2.0",
    "@google-cloud/storage": "8.2.0",
    "@google/genai": "2.23.0",
    "busboy": "1.6.0",
    "cors": "2.8.5",
    "express": "4.21.2",
    "firebase-admin": "13.0.2",
    "helmet": "8.0.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.17.24",
    "tsx": "4.19.3",
    "typescript": "5.7.3"
  }
}
